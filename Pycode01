#Rock_Paper_Scissors Game

# Import the random module to make a random choice for the computer
import random

# Create a list containing all possible choices
choices = ["rock", "paper", "scissors"]

# Initialize the scores of the user and computer
user_score = 0
computer_score = 0

# Start the game 
while True:

    print("\n--- Rock Paper Scissors Game ---")

    user = input("Choose rock, paper, or scissors: ").lower()

   
    if user not in choices:
        print("Invalid choice! Please choose rock, paper, or scissors.")
        continue  # Restart
   
    computer = random.choice(choices)


    print("You chose:", user)
    print("Computer chose:", computer)
     # Check if both choices are the same
    if user == computer:
        print("It's a tie!")

    # Check the conditions in which the user wins
    elif (user == "rock" and computer == "scissors") or \
         (user == "scissors" and computer == "paper") or \
         (user == "paper" and computer == "rock"):

      
        print("You win!")

     
        user_score += 1
      
    else:
        print("Computer wins!")
        computer_score += 1

    # Display the current scores
    print("Your Score:", user_score)
    print("Computer Score:", computer_score)

    # Ask the user whether they want to play another round
    play_again = input("Do you want to play again? (yes/no): ").lower()

    # If the user does not enter yes, stop the game
    if play_again != "yes":
        print("\nThanks for playing!")
        break 
